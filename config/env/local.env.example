# Shared local runtime profile for the backend and frontend.
AI_WORKER_PROFILE=local
NODE_ENV=development
AI_WORKER_MACHINE_ID=

PORT=8000
FIREBASE_DB_URL=https://zte-app-state-mgmt-01-default-rtdb.asia-southeast1.firebasedatabase.app/ai-worker-platform
FIREBASE_DB_MOCK=false
STORAGE_ROOT=./storage
CREATE_PR_CD_ROOT=./skills/create-pr-cd
RAN_CREATE_PR_CD_ROOT=./skills/create-pr-cd-ran
RAN_WORKSPACE_ROOT=./storage/ran-workspaces
PR_AUDITOR_ROOT=./skills/tx-pr-auditor
PYTHON_EXECUTABLE=

QUEUE_LEASE_DURATION_MS=45000
QUEUE_HEARTBEAT_INTERVAL_MS=15000
QUEUE_RECONCILIATION_INTERVAL_MS=30000
WS_HEARTBEAT_INTERVAL_MS=5000
WS_MAX_PAYLOAD_BYTES=16384

LLM_ENABLED=false
LLM_PROVIDER=qwen
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen3-235B-A22B
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_PROGRESS_WORDING_ENABLED=true
LLM_FINAL_SUMMARY_ENABLED=true
LLM_REASK_ENABLED=true

MAX_UPLOAD_SIZE_MB=100
MAX_ROW_COUNT=50000
MAX_SITE_CODES=5000
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MINUTES=60
MAX_OUTPUT_FILES=200
FILE_RETENTION_DAYS=180

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me
JWT_SECRET=change-me-local-jwt-secret
JWT_EXPIRES_IN=8h
DEPLOY_SCRIPT_DIRECTORY=

VITE_APP_BASE=/
VITE_ROUTER_MODE=history
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws
